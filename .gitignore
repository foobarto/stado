/stado
/fakelsp
*.db
*.log
.stado/

# Agent assistant config — local development tooling for AI coding
# assistants (Codex, Claude Code, etc). Not stado source.
/AGENTS.md
/CLAUDE.md
.claude/

# Agent-only working trees. Kept locally for the agent to read across
# sessions but excluded from version control per operator request.
/.agent/
/.learnings/

# Project-local scratch directory for the coding agent (consult dumps,
# build artefacts, throwaway transcripts). Per project CLAUDE.md.
/.tmp/

# Host-backed project-local build and linter caches. Keeping persistent Go
# caches here avoids filling the devbox's virtual /tmp and /var/tmp disks.
/.cache/

# GoReleaser writes metadata into dist/ before invoking `go build`. Keep the
# generated tree ignored so -buildvcs=true records the tagged source as clean.
/dist/

# Binary blobs fetched by `go run hack/fetch-binaries.go` + the per-
# platform embed files it generates. Release builds run the script as
# a goreleaser before-hook; dev builds don't need them.
/internal/rg/bundled/*
!/internal/rg/bundled/.gitkeep
/internal/rg/bundled_*_*.go
/internal/astgrep/bundled/*
!/internal/astgrep/bundled/.gitkeep
/internal/astgrep/bundled_*_*.go

# Example-plugin build artefacts (committed source + manifest template
# only; build.sh regenerates these).
/examples/plugins/*/plugin.wasm
/examples/plugins/*/plugin.manifest.json
/examples/plugins/*/plugin.manifest.sig
/examples/plugins/*/*.seed
/examples/plugins/*/*.o
/examples/plugins/*/go.sum
/examples/plugins/*/.zig-cache/
/examples/plugins/*/zig-cache/
/examples/plugins/*/zig-out/
.env
NOTES*.md

.crush/
.codex

# Per-machine MCP / language-server config. .mcp.json embeds absolute
# paths so it's local-only; .serena/ holds per-project LSP indexes and
# the operator's own project.local.yml.
/.mcp.json
/.serena/

# Plugin signing seeds (Ed25519 private keys) — never commit any.
**/*.seed

# Bundled wasm are built from source at build time (make wasm / goreleaser
# before-hook / go generate), not committed (EP-0042 Part B). They're embedded
# into the signed stado binary; no separate signing. `go install` is not a
# supported path for this reason — use `git clone && make`.
/internal/plugins/bundled/wasm/*.wasm
/internal/plugins/bundled/wasm/.wasm.stamp
