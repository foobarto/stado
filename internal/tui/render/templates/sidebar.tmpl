{{- /* Right sidebar — sections rendered in the operator-configured order
       (.Sections, #21). Each id dispatches to its block; an unknown id
       (e.g. a plugin panel) is handled by the PluginPanels pass, not here. */ -}}
{{- range .Sections }}
{{- if eq . "header" }}
{{ color "text" $.Title | bold }}
{{- if $.SessionLabel }}
{{ color "text_secondary" (wrapHard $.SessionLabel $.Width) }}
{{- end }}
{{- if $.SessionMeta }}
{{ color "text_dim" (wrapHard $.SessionMeta $.Width) }}
{{- end }}
{{- else if eq . "now" }}{{ if $.NowLines }}

{{ color "text" "Now" | bold }}
{{- range $.NowLines }}
{{ color .Tone (wrapHard .Text $.Width) }}
{{- end }}
{{- end }}
{{- else if eq . "subagents" }}{{ if $.Subagents }}

{{ color "text" "Subagents" | bold }}
{{- range $.Subagents }}
{{ color .Tone (wrapHard .Text $.Width) }}
{{- end }}
{{- end }}
{{- else if eq . "risk" }}{{ if $.RiskLines }}

{{ color "text" "Risk" | bold }}
{{- range $.RiskLines }}
{{ color .Tone (wrapHard .Text $.Width) }}
{{- end }}
{{- end }}
{{- else if eq . "agent" }}{{ if $.AgentLines }}

{{ color "text" "Agent" | bold }}
{{- range $.AgentLines }}
{{ color .Tone (wrapHard .Text $.Width) }}
{{- end }}
{{- end }}
{{- else if eq . "repo" }}{{ if $.RepoLines }}

{{ color "text" "Repo" | bold }}
{{- range $.RepoLines }}
{{ color .Tone (wrapHard .Text $.Width) }}
{{- end }}
{{- end }}
{{- else if eq . "logs" }}{{ if $.LogLines }}

{{ color "text" "Logs" | bold }}
{{- range $.LogLines }}
{{ color .Tone (wrapHard .Text $.Width) }}
{{- end }}
{{- end }}
{{- else if eq . "todos" }}{{ if or $.TodoSummary $.Todos }}

{{ color "text" "Todo" | bold }}
{{- if $.TodoSummary }}
{{ color "muted" (wrapHard $.TodoSummary $.Width) }}
{{- end }}
{{- range $.Todos }}
{{ todoMarker .Status }} {{ color (todoColor .Status) (wrapHard .Title $.Width) }}
{{- end }}
{{- end }}
{{- else if $.PluginPanels }}{{ with index $.PluginPanels . }}

{{ color "text" .Heading | bold }}
{{- range .Lines }}
{{ color .Tone (wrapHard .Text $.Width) }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}

{{ color "text_dim" .Version }}
