{{- /* Inline status line inside the input frame: simple and low-noise.
       Every span paints the surface background (colorbg, not color) so the
       row reads solid inside the dark input frame — foreground-only spans
       emit a reset that leaves grey holes between the columns and after the
       text, which the frame can't repaint. */ -}}
{{ if .VimMode }}{{ if eq .VimMode "NORMAL" }}{{ colorbg "primary" "surface" "NORMAL" | bold }}{{ else if eq .VimMode "VISUAL" }}{{ colorbg "accent" "surface" "VISUAL" | bold }}{{ else }}{{ colorbg "success" "surface" "INSERT" | bold }}{{ end }}{{ colorbg "muted" "surface" " · " }}{{ end }}{{ if eq .Mode "Plan" }}{{ colorbg "warning" "surface" "Plan" | bold }}{{ else if eq .Mode "BTW" }}{{ colorbg "accent" "surface" "BTW" | bold }}{{ else }}{{ colorbg "role_user" "surface" "Do" | bold }}{{ end }}{{ colorbg "muted" "surface" " · " }}{{ colorbg "text_secondary" "surface" .Model | bold }}{{ if .ProviderName }}{{ colorbg "muted" "surface" " · " }}{{ colorbg "muted" "surface" .ProviderName }}{{ end }}{{ if .Hint }}{{ colorbg "muted" "surface" " · " }}{{ colorbg "accent" "surface" .Hint }}{{ end }}
